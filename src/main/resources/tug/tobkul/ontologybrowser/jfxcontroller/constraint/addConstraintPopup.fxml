<GridPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" vgap="10.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tug.tobkul.ontologybrowser.jfxcontroller.constraint.AddConstraintPopupController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="65.0" />
        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="300.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="65.0" />
    </columnConstraints>
    <rowConstraints>
      <RowConstraints minHeight="10.0" prefHeight="30.0" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" />
      <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="20.0" valignment="CENTER" vgrow="SOMETIMES" />
    </rowConstraints>
    <children>
        <Button alignment="TOP_LEFT" defaultButton="true" mnemonicParsing="false" onAction="#onConfirm" text="Confirm" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="8" GridPane.valignment="CENTER" />
      <Label text="Name:" />
      <TextField fx:id="nameField" maxWidth="150.0" prefWidth="150.0" GridPane.columnIndex="1">
         <GridPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </GridPane.margin>
      </TextField>
      <Label fx:id="invalidInputLabel" text="-" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="8" />
      <TextArea fx:id="commentField" maxWidth="150.0" prefHeight="40.0" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
         <GridPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </GridPane.margin>
      </TextArea>
      <VBox prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="1">
         <children>
            <Label text="Comment:" />
            <Label text="(Optional)" />
         </children>
      </VBox>
      <ScrollPane fitToHeight="true" GridPane.columnSpan="3" GridPane.halignment="CENTER" GridPane.rowIndex="5" GridPane.rowSpan="2" GridPane.valignment="CENTER">
         <content>
            <HBox fx:id="constraintHBox" alignment="CENTER" />
         </content>
      </ScrollPane>
      <Label text="Constraint:" GridPane.rowIndex="3" />
      <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnSpan="2147483647" GridPane.rowIndex="7">
         <children>
            <Button fx:id="newRootButton" maxWidth="72.0" minWidth="72.0" mnemonicParsing="false" onAction="#onNewRootConstraint" text="New Root" />
            <Button mnemonicParsing="false" onAction="#onEdit" text="Edit" />
            <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Make Composite:" />
                  <Button mnemonicParsing="false" onAction="#onExtendLeft" text="Extend Left" />
                  <Button mnemonicParsing="false" onAction="#onExtendRight" text="Extend Right" />
               </children>
            </HBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT" nodeOrientation="LEFT_TO_RIGHT" spacing="5.0" GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="2">
         <children>
            <Label text="Add quantifier:" />
            <Button fx:id="addQuantifierForAllButton" mnemonicParsing="false" onAction="#onAddForAll" text="∀" />
            <Button fx:id="addQuantifierExistsButton" mnemonicParsing="false" onAction="#onAddExists" text="∃" />
         </children>
      </HBox>
      <ScrollPane fitToHeight="true" GridPane.columnSpan="2147483647" GridPane.rowIndex="4">
         <content>
            <HBox fx:id="quantifierHBox" alignment="CENTER" spacing="3.0">
